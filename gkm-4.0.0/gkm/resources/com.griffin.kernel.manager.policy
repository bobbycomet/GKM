<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Griffin Kernel Manager</vendor>
  <vendor_url>https://github.com/bobbycomet/XKM-Multi-Kernel-Manager</vendor_url>
  <icon_name>gkm</icon_name>

  <action id="com.griffin.kernel.manager.helper">
    <description>Manage Linux kernel packages</description>
    <message>Authentication is required to install, remove, hold or configure kernel packages</message>
    <icon_name>gkm</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/gkm/gkm-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
